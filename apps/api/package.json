  "dependencies": {
    "@routiq/contracts": "workspace:*",
    "@routiq/domain": "workspace:*",
    "@aws-sdk/client-s3": "3.1093.0",
    "@aws-sdk/s3-request-presigner": "3.1093.0",
    "@sentry/node": "10.67.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.10.0",
    "file-type": "22.0.1",
    "pg": "^8.16.0",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.0.4",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
