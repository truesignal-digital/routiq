{
  "name": "@routiq/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "provision": "tsx scripts/provision.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "smoke": "tsx scripts/smoke.ts",
