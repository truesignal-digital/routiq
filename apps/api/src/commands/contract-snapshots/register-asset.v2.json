{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "assetId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "assetCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "assetClassCode": {
      "type": "string",
      "minLength": 1
    },
    "templateCode": {
      "type": "string",
      "enum": [
        "TRUCKING",
        "PASSENGER_TRANSPORT"
      ]
    },
    "branchCode": {
      "type": "string",
      "minLength": 1
    },
    "registrationNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "chassisNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 17
    },
    "manufacturer": {
      "type": "string",
      "maxLength": 80
    },
    "model": {
      "type": "string",
      "maxLength": 80
    },
    "modelYear": {
      "type": "integer",
      "minimum": 1950,
      "maximum": 2100
    },
    "acquisitionDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "acquisitionAmountMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capacityValue": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "capacityUnit": {
      "type": "string",
      "enum": [
        "KG",
        "TONNE",
        "M3",
        "SEAT"
      ]
    },
    "customValues": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "assetId",
    "assetCode",
    "assetClassCode",
    "templateCode",
    "branchCode"
  ]
}
