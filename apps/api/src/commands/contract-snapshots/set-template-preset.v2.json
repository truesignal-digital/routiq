{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspaceSlug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "presetCode": {
      "type": "string",
      "enum": [
        "TRUCKING",
        "PASSENGER_TRANSPORT"
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "required": [
    "workspaceSlug",
    "presetCode",
    "enabled"
  ],
  "additionalProperties": false
}
