{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "personId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "branchCode": {
      "type": "string",
      "minLength": 1
    },
    "personCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "phone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "defaultRole": {
      "type": "string",
      "enum": [
        "DRIVER",
        "CONDUCTOR",
        "ASSISTANT",
        "RELIEF",
        "MECHANIC",
        "CLERK",
        "OTHER"
      ]
    }
  },
  "required": [
    "personId",
    "displayName",
    "branchCode"
  ]
}
