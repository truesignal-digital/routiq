{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workspace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "defaultCurrency": {
          "default": "XAF",
          "type": "string",
          "enum": [
            "XAF"
          ]
        },
        "timezone": {
          "default": "Africa/Douala",
          "type": "string"
        },
        "defaultLocale": {
          "default": "fr-CM",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "name"
      ],
      "additionalProperties": false
    },
    "branches": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9]{2,8}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "admin": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "pin": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "displayName",
        "username",
        "pin"
      ],
      "additionalProperties": false
    },
    "enabledPresets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "TRUCKING",
          "PASSENGER_TRANSPORT"
        ]
      }
    },
    "disabledModules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ASSETS",
          "DOCUMENTS",
          "FINANCE",
          "ACTIVITIES"
        ]
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "pin": {
            "type": "string",
            "minLength": 4,
            "maxLength": 64
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "OPS_MANAGER",
              "FIELD_SUBMITTER",
              "MAINTENANCE",
              "FINANCE_APPROVER",
              "EXECUTIVE_VIEWER"
            ]
          },
          "branchScope": {
            "anyOf": [
              {
                "type": "string",
                "const": "ALL"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            ]
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "pin",
          "role",
          "branchScope"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "workspace",
    "branches",
    "admin",
    "enabledPresets"
  ],
  "additionalProperties": false
}
