# copy to .env — never commit .env
# Restricted application traffic (FORCE RLS applies).
DATABASE_URL=postgres://routiq_app:routiq_app@localhost:5435/routiq_dev
# Privileged bootstrap path; confine it to login/session/membership resolution.
AUTH_DATABASE_URL=postgres://routiq:routiq@localhost:5435/routiq_dev
# Schema changes use the owner connection separately.
MIGRATION_DATABASE_URL=postgres://routiq:routiq@localhost:5435/routiq_dev
PORT=3001
# Keys the HMAC that fingerprints command payloads for idempotency, so a stored
# receipt cannot be brute-forced back into the PIN it redacted. Generate with
# `openssl rand -hex 32`. The API refuses to start without it. Rotating it
# invalidates existing fingerprints, so retries in flight stop replaying.
COMMAND_PAYLOAD_HMAC_KEY=4989b18393504ca276954deab1c4454f73496b015826d3e34319fbc0af7a9d19
# S3-compatible object storage for artifact uploads. Optional: if unset, the API
# will not register artifact routes. Leave as-is for docker-compose appliance;
# a real deployment should supply an S3 endpoint (e.g., AWS S3, managed MinIO,
# on-prem RustFS) and rotate the credentials.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=artifacts
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
